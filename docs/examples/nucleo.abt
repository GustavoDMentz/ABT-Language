amostra = [30, 12, 18, 12, 24]
mostrar minimo(amostra)
mostrar maximo(amostra)
mostrar ordenar(amostra)
mostrar ordenar(amostra, "decrescente")
mostrar sem_duplicatas(amostra)
mostrar para_inteiro("42") + 1
